# Copy to `.env` and adjust. The server refuses to start without a token.

# Port the companion server listens on.
PORT=8787

# Shared secret. The mobile app sends this as a Bearer token. Use a long random string.
LLOCAL_SERVER_TOKEN=change-me-to-a-long-random-string

# Ollama server URL as seen from THIS machine (the server runs next to Ollama).
OLLAMA_URL=http://127.0.0.1:11434

# Where the server stores knowledge-base vector DBs and cloned repos.
LLOCAL_DATA_DIR=

# CORS origin allowed to call the server. Use * for a personal LAN setup, or the
# app origin (capacitor://localhost / http://localhost) to lock it down.
LLOCAL_CORS_ORIGIN=*

# --- Command execution (DANGEROUS: read server/README.md before enabling) ---
# Must be exactly "1" to enable the /exec endpoint. Off by default.
LLOCAL_ENABLE_EXEC=0
# Optional comma-separated allowlist of command names (first token). Empty = any.
LLOCAL_EXEC_ALLOWLIST=git,unzip,ls,cat,npm,node,make

# --- GitHub (used for pushing / PRs) ---
# A fine-grained or classic PAT with repo scope. Can also be supplied per-request.
GITHUB_TOKEN=
